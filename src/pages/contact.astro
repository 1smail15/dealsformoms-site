---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact" description="Get in touch with Deals For Moms — corrections, tips, and partnership enquiries.">
  <div class="wrap" style="padding-top:48px">
    <div class="prose">
      <h1>Contact</h1>
      <p>The fastest way to reach me is through the Deals For Moms Facebook page.</p>
      <h2>Corrections</h2>
      <p>If a price or a markdown date on this site is wrong, send me the store, the date and a photo of the tag if you have one. I will update the post and add a correction note with the date.</p>
      <h2>Brands and partnerships</h2>
      <p>I work with affiliate networks, not with brands directly on editorial. Placement cannot be bought — see the <a href="/editorial-policy">editorial policy</a>.</p>
    </div>
  </div>
</BaseLayout>
