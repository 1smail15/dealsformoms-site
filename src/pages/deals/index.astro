---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublished } from '../../lib/content';

const posts = await getPublished('deals');
---
<BaseLayout
  title="This Week's Clearance Finds"
  description="Clearance finds I checked in store this week — with the aisle, the tag price, and what it rang up as."
>
  <div class="wrap">
    <div class="hero-plain tone tone-yellow">
      <h1>This Week's Finds</h1>
      <p class="lede">Everything here was on a shelf I walked. Stock is store-by-store, so scan before you drive.</p>
    </div>
    <section class="block">
      <ul class="card-grid">
        {posts.map((p: any) => <PostCard post={p} section="deals" />)}
      </ul>
      {posts.length === 0 && <p>No finds published yet — check back after this week's store run.</p>}
    </section>
  </div>
</BaseLayout>
