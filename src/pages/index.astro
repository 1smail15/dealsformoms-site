---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import PromoCard from '../components/PromoCard.astro';
import Newsletter from '../components/Newsletter.astro';
import { SITE, FACEBOOK } from '../consts';
import { getPublished } from '../lib/content';
import allPromos from '../data/promos.json';

const deals = (await getPublished('deals')).slice(0, 6);
const guides = (await getPublished('guides')).slice(0, 6);
const promos = allPromos.slice(0, 3);

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE.url}#org`,
      name: SITE.title,
      url: SITE.url,
      description: SITE.description,
      sameAs: SITE.author.sameAs,
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}#site`,
      url: SITE.url,
      name: SITE.title,
      publisher: { '@id': `${SITE.url}#org` },
    },
  ],
};
---
<BaseLayout title={SITE.title} description={SITE.description} schema={schema}>
  <div class="hero-band">
    <div class="wrap hero">
      <div class="hero-copy">
        <h1>Real clearance finds,<br />checked in store.</h1>
        <p class="lede">
          Every week I check clearance aisles at Walmart, Target, and beyond,
          and dig up the online promo codes worth grabbing too.
        </p>
        <div class="social-cta">
          <a class="btn-social btn-fb" href={FACEBOOK.page} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.51 1.49-3.9 3.77-3.9 1.09 0 2.23.2 2.23.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.87h2.78l-.44 2.91h-2.34v7.03C18.34 21.24 22 17.08 22 12.06Z"/></svg>
            Follow us on Facebook
          </a>
          <a class="btn-social btn-fb-outline" href={FACEBOOK.group} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.51 1.49-3.9 3.77-3.9 1.09 0 2.23.2 2.23.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.87h2.78l-.44 2.91h-2.34v7.03C18.34 21.24 22 17.08 22 12.06Z"/></svg>
            Join our Facebook Group
          </a>
        </div>
      </div>
      <div class="hero-photos" aria-hidden="true">
        <img src="/images/deals/bhg-towel-bundle.png" alt="" loading="eager" />
        <img src="/images/deals/carote-pots-pans-purple.png" alt="" loading="eager" />
        <img src="/images/deals/beautiful-bread-oven-white.png" alt="" loading="eager" />
      </div>
      <nav class="topics" aria-label="Browse by topic">
        <a href="/deals" class="topic-tile">
          <span class="topic-img" style={`background-image:url(${deals[0]?.data.heroImage ?? '/images/deals/bhg-towel-bundle.png'})`}></span>
          <span class="topic-label">
            <span class="topic-icon tone-yellow"><svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.77 5.82 21 7 14.14l-5-4.87 6.91-1.01L12 2z"/></svg></span>
            This week's top finds
          </span>
        </a>
        <a href="/shop" class="topic-tile">
          <span class="topic-img" style="background-image:url(/images/deals/cook-with-color-snack-tray.png)"></span>
          <span class="topic-label">
            <span class="topic-icon tone-blue"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 8V6a6 6 0 0 1 12 0v2M4 8h16l-1.2 12.1a2 2 0 0 1-2 1.9H7.2a2 2 0 0 1-2-1.9L4 8Z"/></svg></span>
            Shop best online deals
          </span>
        </a>
        <a href="/guides/pillar/calendar" class="topic-tile">
          <span class="topic-img" style="background-image:url(/images/deals/mainstays-chelsea-patio-set.png); background-position:center 78%;"></span>
          <span class="topic-label">
            <span class="topic-icon tone-red"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/><circle cx="8" cy="15" r="1.2" fill="currentColor" stroke="none"/><circle cx="12" cy="15" r="1.2" fill="currentColor" stroke="none"/><circle cx="16" cy="15" r="1.2" fill="currentColor" stroke="none"/></svg></span>
            Markdown calendar
          </span>
        </a>
        <a href="/guides/pillar/mechanics" class="topic-tile">
          <span class="topic-img" style="background-image:url(/images/deals/clearance-tag-137-pajamas.png)"></span>
          <span class="topic-label">
            <span class="topic-icon tone-ink"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20.59 13.41 12 22l-9-9 8.59-8.59A2 2 0 0 1 13 4h6a1 1 0 0 1 1 1v6a2 2 0 0 1-.41 1.41Z"/></svg></span>
            Price code decoder
          </span>
        </a>
        <a href="/guides/pillar/tools" class="topic-tile">
          <span class="topic-img" style="background-image:url(/images/deals/walmart-app-deals-endcap.png)"></span>
          <span class="topic-label">
            <span class="topic-icon tone-ink"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7V4h3M20 7V4h-3M4 17v3h3M20 17v3h-3"/><path d="M4 12h16"/></svg></span>
            Scan &amp; save
          </span>
        </a>
      </nav>
    </div>
  </div>

  <div class="wrap">
    <section class="block">
      <div class="section-head">
        <h2>This week's finds</h2>
        <a href="/deals">All finds &rarr;</a>
      </div>
      {deals.length > 0 ? (
        <ul class="card-grid">
          {deals.map((p: any) => <PostCard post={p} section="deals" />)}
        </ul>
      ) : (
        <p>First store run posts here.</p>
      )}
    </section>

    <section class="block">
      <div class="section-head">
        <h2>Online promo codes</h2>
        <a href="/promos">All promo codes &rarr;</a>
      </div>
      {promos.length > 0 ? (
        promos.map((p: any) => <PromoCard promo={p} />)
      ) : (
        <p>No active promo codes right now — check back soon.</p>
      )}
    </section>

    <section class="block">
      <div class="section-head">
        <h2>How clearance actually works</h2>
        <a href="/guides">All guides &rarr;</a>
      </div>
      <ul class="card-grid">
        {guides.map((g: any) => <PostCard post={g} section="guides" />)}
      </ul>
    </section>

    <Newsletter />
  </div>
</BaseLayout>
