---
import BaseLayout from '../../layouts/BaseLayout.astro';
import catalog from '../../data/catalog.json';

const groups = new Map<string, { label: string; n: number; image?: string }>();
for (const p of catalog as any[]) {
  const cur = groups.get(p.category);
  if (cur) {
    cur.n++;
    if (!cur.image && p.image) cur.image = p.image;
  } else {
    groups.set(p.category, { label: p.categoryLabel, n: 1, image: p.image });
  }
}
const categories = [...groups.entries()]
  .map(([key, v]) => ({ key, ...v }))
  .sort((a, b) => b.n - a.n);
---
<BaseLayout
  title="Shop Best Online Deals"
  description="Online deals sourced and organized by category — not in-store finds, just sales worth knowing about."
>
  <div class="wrap">
    <div class="hero-plain tone tone-blue">
      <h1>Shop Best Online Deals</h1>
      <p class="lede">
        These are online deals I source and share — not something I walked an
        aisle for. Browse by category below; each one is refreshed as prices
        change.
      </p>
    </div>
    <section class="block">
      <div class="topics topics-grid">
        {categories.map((c) => (
          <a href={`/shop/${c.key}`} class="topic-tile">
            <span class="topic-img contain">
              {c.image
                ? <img src={c.image} alt={c.label} loading="lazy" decoding="async" width="300" height="300" />
                : <span class="topic-img-placeholder" aria-hidden="true">{c.label}</span>}
            </span>
            <span class="topic-label">
              <span class="topic-icon tone-blue"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 8V6a6 6 0 0 1 12 0v2M4 8h16l-1.2 12.1a2 2 0 0 1-2 1.9H7.2a2 2 0 0 1-2-1.9L4 8Z"/></svg></span>
              <span>{c.label}</span>
            </span>
            <span class="topic-meta">{c.n} deal{c.n === 1 ? '' : 's'}</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
