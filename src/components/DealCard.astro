---
interface Props {
  deal: {
    id: string;
    name: string;
    image?: string;
    price?: string;
    priceOld?: string;
    /** Which retailer this deal is from. Defaults to Walmart for older entries. */
    store?: string;
    /** Already resolved by the export script: /go/<code> or a raw network URL. */
    href: string;
  };
}
const { deal } = Astro.props;
const store = deal.store ?? 'Walmart';

const pct = (() => {
  if (!deal.price || !deal.priceOld) return null;
  const now = Number(String(deal.price).replace(/[^0-9.]/g, ''));
  const was = Number(String(deal.priceOld).replace(/[^0-9.]/g, ''));
  if (!now || !was || was <= now) return null;
  return Math.round((1 - now / was) * 100);
})();
---
<div class="deal">
  <div class="deal-media">
    {deal.image
      ? <img src={deal.image} alt={deal.name} width="108" height="108" loading="lazy" decoding="async" />
      : <div style="width:108px;height:108px;background:#f2f0eb;border-radius:6px"></div>}
    {pct && <span class="pct-badge">{pct}% off</span>}
  </div>
  <div>
    <p class="deal-name">{deal.name}</p>
    {deal.price && (
      <p class="price">
        {deal.price}
        {deal.priceOld && <s>{deal.priceOld}</s>}
      </p>
    )}
    <a class="btn" href={deal.href} rel="sponsored nofollow noopener" target="_blank">
      See it at {store}
    </a>
  </div>
</div>
